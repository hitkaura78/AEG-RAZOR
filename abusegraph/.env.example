# AEG-RAZOR Environment Variables Template

# Database Connection (Defaults to local SQLite, or set to PostgreSQL e.g. Supabase/Neon)
DATABASE_URL=sqlite:///abusegraph.db

# JWT Security & Auth Tokens
JWT_SECRET_KEY=9566e5d4448e1b2cacbd75eedaaf2a8cbcb1521c0109d21006858b6c036406b9
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# LLM Investigation Agent (Optional: Google Gemini 2.5 Flash Integration)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma-separated list of domain URLs, or * for local dev)
CORS_ORIGINS=*